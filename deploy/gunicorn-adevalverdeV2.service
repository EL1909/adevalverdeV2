# /etc/systemd/system/gunicorn-adevalverdeV2.service
#   sudo cp deploy/gunicorn-adevalverdeV2.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now gunicorn-adevalverdeV2
#
# Puerto 8003: comprobar que está libre en la VM (sudo ss -ltnp).
# 2 workers bastan para el tráfico de Adela (~80 MB de RAM cada uno).

[Unit]
Description=gunicorn adevalverdeV2
After=network.target postgresql.service

[Service]
User=efrain19091
Group=www-data
WorkingDirectory=/home/efrain19091/projects/adevalverdeV2/adevalverdeV2/backend
ExecStart=/home/efrain19091/projects/adevalverdeV2/venv/bin/gunicorn \
    --workers 2 --timeout 60 \
    --bind 127.0.0.1:8003 \
    core.wsgi:application
Restart=on-failure

[Install]
WantedBy=multi-user.target
